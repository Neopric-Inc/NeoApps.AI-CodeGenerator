        "validation_status"
      ],
      "fields": {
        "validation_status": {
          "widget": "select",
          "options": [
            "pending",
            "passed",
            "failed",
            "warning"
          ],
          "colors": {
            "pending": "warning",
            "passed": "success",
            "failed": "error",
            "warning": "warning"
          }
        }
      }
    },
