  "ai": {
    "enabled": true,
    "model": "claude-sonnet-5-5",
    "assistantName": "QuickBooks AI Accountant",
    "instructions": "You are the AI accountant for a CPA Document Intelligence Platform. You help CPA firms manage document intake, workflow automation, audit engagements, and Canadian tax compliance (CRA). You have access to specialized agents for intake, extraction, workflow, audit, tax, client communication, and review. You can orchestrate multi-agent workflows for complex processes like bank reconciliation, PBC collection, tax return preparation, and audit fieldwork. Always cite sources from documents and records. Respect user permissions and data scoping. Ask clarifying questions when ambiguous.",
    "documentTables": [
      "source_documents",
      "audit_workpapers",
      "attachments"
    ],
    "tools": [
      "records",
      "documents",
      "workflows",
      "cra_filing",
      "audit_procedures"
    ],
    "suggestions": [
      "Upload January bank statements for all clients",
      "Start PBC collection for Acme Corp FY2024 audit",
      "Prepare Q1 2025 GST/HST returns for all clients",
      "Run bank reconciliation for Chase checking accounts",
      "Generate audit planning memo for new engagement",
      "Check for overdue CRA payroll remittances",
      "Create recurring invoice templates for retainer clients",
      "Analyze flux variances for month-end close"
    ],
    "workflows": [
      {
        "id": "bank_reconciliation",
        "label": "Bank Reconciliation Wizard",
        "description": "Upload statements → OCR → Auto-match → Review exceptions → Complete reconciliation",
        "targets": [
          "bank_statements",
          "statement_transactions",
          "bank_transactions"
        ],
        "tools": [
          "records",
          "documents"
        ],
        "instructions": "1. User uploads bank statement PDF. 2. Intake agent processes via OCR. 3. Extraction agent parses transactions. 4. Workflow agent matches to existing transactions. 5. Human reviews exceptions. 6. Post reconciliation."
      },
      {
        "id": "pbc_collection",
        "label": "PBC Request & Collection",
        "description": "Create request list → Send to client portal → Track uploads → Review → Link to workpapers",
        "targets": [
          "document_requests",
          "request_items",
          "source_documents",
          "audit_workpapers"
        ],
        "tools": [
          "records",
          "documents",
          "workflows"
        ],
        "instructions": "1. Senior creates PBC request from audit program. 2. Client notified via portal. 3. Client uploads documents. 4. Staff reviews and links to workpapers. 5. Track completion status."
      },
      {
        "id": "gst_hst_filing",
        "label": "GST/HST Return Preparation",
        "description": "Collect transactions → Calculate liability → Generate GSTR lines → Review → NETFILE",
        "targets": [
          "cra_gst_hst_returns",
          "cra_gst_hst_line_details",
          "gl_entries"
        ],
        "tools": [
          "records",
          "cra_filing"
        ],
        "instructions": "1. Tax agent pulls sales/purchase transactions for period. 2. Calculates GST/HST collected and ITCs. 3. Populates lines 101-113. 4. Senior reviews. 5. Files via NETFILE."
      },
      {
        "id": "audit_fieldwork",
        "label": "Audit Fieldwork Execution",
        "description": "Select procedures → Assign to team → Execute → Document evidence → Review → Conclude",
        "targets": [
          "audit_procedures",
          "procedure_executions",
          "sampling_plans",
          "sample_items",
          "audit_workpapers"
        ],
        "tools": [
          "records",
          "audit_procedures"
        ],
        "instructions": "1. Manager assigns procedures from audit program. 2. Staff executes and documents evidence. 3. Sampling performed per plan. 4. Senior reviews. 5. Manager approves. 6. Partner signs off."
      },
      {
        "id": "month_end_close",
        "label": "Month-End Close Process",
        "description": "Run recurring JEs → Reconcile accounts → Flux analysis → Review → Lock period",
        "targets": [
          "gl_entries",
          "recurring_templates",
          "bank_transactions",
          "analytical_procedures"
        ],
        "tools": [
          "records",
          "workflows"
        ],
        "instructions": "1. Generate recurring journal entries. 2. Reconcile all bank accounts. 3. Run analytical procedures (flux). 4. Review variances. 5. Post adjusting entries. 6. Lock period."
      },
      {
        "id": "invoice_processing",
        "label": "Invoice Processing (3-Way Match)",
        "description": "Receive invoice → Extract data → Match PO/Receipt → Approve → Schedule payment",
        "targets": [
          "source_documents",
          "extracted_fields",
          "purchase_orders",
          "bills",
          "bill_lines"
        ],
        "tools": [
          "records",
          "documents",
          "workflows"
        ],
        "instructions": "1. Invoice received via intake. 2. OCR extracts header and line data. 3. Match to PO and receiving. 4. Route for approval. 5. Create bill. 6. Schedule payment."
      }
    ]
  }
