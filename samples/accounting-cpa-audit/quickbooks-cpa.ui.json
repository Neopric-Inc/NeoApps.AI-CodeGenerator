  "dashboard": {
    "cards": [
      {
        "table": "source_documents",
        "label": "Documents Processing",
        "filters": {
          "status": [
            "uploaded",
            "processing",
            "classifying",
            "extracting"
          ]
        }
      },
      {
        "table": "workflow_instances",
        "label": "Active Workflows",
        "filters": {
          "status": "running"
        }
      },
      {
        "table": "workflow_tasks",
        "label": "My Pending Tasks",
        "filters": {
          "status": [
            "pending",
            "assigned",
            "in_progress"
          ]
        }
      },
      {
        "table": "document_requests",
        "label": "Outstanding PBC Requests",
        "filters": {
          "status": [
            "sent",
            "in_progress"
          ]
        }
      },
      {
        "table": "invoices",
        "label": "AR Balance",
        "sum": "balance_due",
        "filters": {
          "status": [
            "sent",
            "partial",
            "overdue"
          ]
        }
      },
      {
        "table": "bills",
        "label": "AP Balance",
        "sum": "balance_due",
        "filters": {
          "status": [
            "open",
            "partial"
          ]
        }
      },
      {
        "table": "bank_accounts",
        "label": "Total Cash",
        "sum": "current_balance"
      },
      {
        "table": "audit_engagements",
        "label": "Active Engagements",
        "filters": {
          "status": [
            "planning",
            "fieldwork",
            "review"
          ]
        }
      },
      {
        "table": "cra_gst_hst_returns",
        "label": "Upcoming CRA Deadlines",
        "filters": {
          "filing_status": [
            "draft",
            "ready_to_file"
          ]
        }
      },
      {
        "table": "agent_workflow_executions",
        "label": "AI Workflows Running",
        "filters": {
          "status": "running"
        }
      }
    ],
    "recentTable": "documents"
  },
