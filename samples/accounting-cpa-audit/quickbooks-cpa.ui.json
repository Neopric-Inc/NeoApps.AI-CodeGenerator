  "tables": {
    "source_documents": {
      "icon": "file_text",
      "displayField": "file_name",
      "listColumns": [
        "file_name",
        "source_type",
        "status",
        "uploaded_at"
      ],
      "fields": {
        "status": {
          "widget": "select",
          "options": [
            "uploaded",
            "virus_scanning",
            "ocr_processing",
            "classifying",
            "extracting",
            "validating",
            "completed",
            "failed",
            "archived"
          ],
          "colors": {
            "uploaded": "default",
            "processing": "info",
            "completed": "success",
            "failed": "error",
            "archived": "warning"
          }
        },
        "source_type": {
          "widget": "select",
          "options": [
            "email_attachment",
            "dropbox_upload",
            "portal_upload",
            "mobile_photo",
            "api",
            "scanner"
          ]
        }
      },
      "children": [
        "document_versions",
        "document_classifications",
        "extracted_fields",
        "document_parsing_jobs"
      ]
    },
    "document_classifications": {
      "icon": "tag",
      "displayField": "document_type",
      "listColumns": [
        "document_type",
        "sub_type",
        "confidence",
        "is_manual_override",
        "classified_at"
      ],
      "fields": {
        "document_type": {
          "widget": "select",
          "options": [
            "invoice",
            "receipt",
            "bank_statement",
            "contract",
            "lease",
            "payroll",
            "tax_notice",
            "board_minutes",
            "legal",
            "other"
          ]
        },
        "confidence": {
          "widget": "progress",
          "format": "percent"
        }
      }
    },
    "extracted_fields": {
      "icon": "database",
      "displayField": "field_name",
      "listColumns": [
        "field_name",
        "field_value",
