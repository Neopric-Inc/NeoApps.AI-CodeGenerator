 "roles": {"Partner": {"*": "cru", "sign_offs": "cr", "engagement_phase_history": "r", "audit_logs": "r"}, "Manager": {"*": "cru", "sign_offs": "cr", "engagement_phase_history": "r", "audit_logs": ""}, "Staff": {"clients": "r", "client_contacts": "r", "engagements": "r", "engagement_phase_history": "r", "document_requests": "cru", "workpapers": "cru", "risks": "cru", "findings": "cru", "sign_offs": "r", "staff_members": "r"}, "Client": {"clients": "r", "client_contacts": "r", "engagements": "r", "document_requests": "ru"}},
 "menuByRole": {"Staff": ["engagements", "document_requests", "workpapers", "risks", "findings", "clients"], "Client": ["engagements", "document_requests"]},
