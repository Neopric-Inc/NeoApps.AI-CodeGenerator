": "Approved", "roles": ["Manager", "Partner"], "adminBypass": false}, {"from": "Approved", "to": "Communicated", "roles": ["Manager", "Partner"]}, {"from": "Communicated", "to": "Resolved", "roles": ["Manager", "Partner"]}]}},
 "validations": {"engagements": {"due_date": {"gt": "period_end", "message": "The due date must be after the period end."}, "materiality_amount": {"min": 0.01}, "performance_materiality": {"lte": "materiality_amount", "message": "Performance materiality can't exceed materiality."}}, "document_requests": {"return_comment": {"requiredWhen": {"request_status": ["Returned"]}, "message": "Tell the client what is wrong before returning it."}}, "findings": {"amount": {"min": 0}}, "client_contacts": {"email": {"format": "email"}}, "staff_members": {"email": {"format": "email"}}},
