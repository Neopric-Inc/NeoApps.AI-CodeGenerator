<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>NeoApps.Mcp</RootNamespace>
    <AssemblyName>neoapps-mcp</AssemblyName>
    <!-- Also installable as a global tool: dotnet pack && dotnet tool install -g neoapps-mcp -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>neoapps</ToolCommandName>
    <PackageId>NeoApps.Mcp</PackageId>
    <Description>MCP server that lets Claude Desktop generate NeoApps.AI apps and run them locally with Docker.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

</Project>
