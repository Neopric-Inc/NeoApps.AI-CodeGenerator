{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": "src",
    "paths": { "neoapps/*": ["neoapps/*"], "custom/*": ["custom/*"] }
  },
  "include": ["src/index.tsx", "src/App.tsx", "src/neoapps", "src/custom", "src/vite-env.d.ts"]
}
