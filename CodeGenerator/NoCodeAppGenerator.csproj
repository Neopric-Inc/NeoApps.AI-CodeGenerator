<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>NoCodeAppGenerator</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Legacy code base: keep the build output readable. -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0162;CS0414;CS0649;CS0169;CS8632;CA2200</NoWarn>
  </PropertyGroup>

  <!-- Templates are data read at runtime, not part of the generator's compilation. -->
  <ItemGroup>
    <Compile Remove="DotNetMySQLTemplate\**;ReactTsTemplate*\**;wwwroot\**" />
    <EmbeddedResource Remove="DotNetMySQLTemplate\**;ReactTsTemplate*\**" />
    <None Remove="DotNetMySQLTemplate\**;ReactTsTemplate*\**" />
    <Content Remove="DotNetMySQLTemplate\**;ReactTsTemplate*\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.*" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="MySqlConnector" Version="2.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
